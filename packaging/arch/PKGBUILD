  'vulkan-headers'
)
optdepends=(
  'geoclue: geoinformation support'
  'webkit2gtk-4.1: embedded browser features provided by webkit2gtk-4.1 (gtk3)'
  'webkitgtk-6.0: embedded browser features provided by webkitgtk-6.0 (gtk4)'
  'xdg-desktop-portal: desktop integration'
)
provides=('sereingram-desktop')
conflicts=('sereingram-desktop')
source=(
  "$_repo::git+https://github.com/eltavine/SereinGram.git#branch=develop"
  "td::git+https://github.com/tdlib/td.git#commit=$_td_commit"
  "tlottie::git+https://github.com/dkaraush/tlottie.git#commit=$_tlottie_commit"
  "wallet-engine::git+https://github.com/i582/wallet-engine.git#commit=$_wallet_engine_commit"
  "patches::git+https://github.com/desktop-app/patches.git#commit=$_patches_commit"
)
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

pkgver() {
  cd "$_repo"
  printf '%s.r%s.g%s' \
    "$(sed -n 's/^AppVersionStrSmall *//p' Telegram/build/version)" \
    "$(git rev-list --count HEAD)" \
    "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_repo"
  git submodule update --init --recursive --depth 1 --jobs 8
  git -C "$srcdir/wallet-engine" apply "$srcdir/patches/wallet-engine.patch"
  mkdir -p "$srcdir/tdesktop_rust"
  cp -r packaging/rust/. "$srcdir/tdesktop_rust/"
  cargo fetch --locked --manifest-path "$srcdir/tdesktop_rust/Cargo.toml"
  cargo fetch --locked --manifest-path "$srcdir/wallet-engine/bindgen/cpp/bindgen/Cargo.toml"
}

build() {
  local credentials=()
  if [[ -z $SEREIN_API_ID || -z $SEREIN_API_HASH ]]; then
    if [[ $SEREIN_API_TEST != 1 ]]; then
      error 'Set SEREIN_API_ID and SEREIN_API_HASH to your own credentials from https://my.telegram.org.'
      return 1
    fi
    warning 'Building with the test-only credentials (SEREIN_API_TEST=1).'
    credentials=(-DTDESKTOP_API_TEST=ON)
  fi
  local published=()
  if [[ -n $SEREIN_BUILD_PACKAGE ]]; then
    published=(
      -DSEREIN_BUILD_PACKAGE="$SEREIN_BUILD_PACKAGE"
      -DSEREIN_BUILD_CHANNEL="$SEREIN_BUILD_CHANNEL"
      -DSEREIN_BUILD_COMMIT="$SEREIN_BUILD_COMMIT"
    )
  fi

  cmake -S td -B td/build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX="$srcdir/td/install" \
    -DTD_E2E_ONLY=ON \
    -Wno-dev
  cmake --build td/build
  cmake --install td/build

  cargo build --offline --locked --release --manifest-path tdesktop_rust/Cargo.toml
  local rust_prefix="$srcdir/tdesktop_rust/install"
  install -Dm644 tdesktop_rust/target/release/libtdesktop_rust.a "$rust_prefix/lib/libtdesktop_rust.a"
  install -Dm644 tlottie/include/tlottie.h "$rust_prefix/include/tlottie/tlottie.h"
  (
    cd tdesktop_rust
    CARGO_NET_OFFLINE=true cargo run --offline --locked \
      --manifest-path ../wallet-engine/bindgen/cpp/bindgen/Cargo.toml -- \
      --library --out-dir "$rust_prefix/include/wallet_engine" \
      target/release/libtdesktop_rust.so
  )

  cmake -S "$_repo" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=None \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -Dtde2e_DIR="$srcdir/td/install/lib/cmake/tde2e" \
    -DCMAKE_PREFIX_PATH="$rust_prefix" \
    "${credentials[@]}" \
    "${published[@]}"
  cmake --build build
}

package() {
  DESTDIR="$pkgdir" cmake --install build
}
