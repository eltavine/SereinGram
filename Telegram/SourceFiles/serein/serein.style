using "ui/widgets/widgets.style";
using "dialogs/dialogs.style";
using "ui/menu_icons.style";
using "settings/settings.style";

sereinSettingsTileSize: 28px;
sereinSettingsTileLeft: 18px;
sereinSettingsTileRadius: 8px;
sereinSettingsButton: SettingsButton(settingsButton) {
	padding: margins(60px, 12px, 22px, 12px);
	iconLeft: 18px;
}
sereinSettingsButtonDescribed: SettingsButton(sereinSettingsButton) {
	padding: margins(60px, 12px, 22px, 3px);
}
sereinSettingsAttentionButtonDescribed: SettingsButton(sereinSettingsButtonDescribed) {
	textFg: attentionButtonFg;
	textFgOver: attentionButtonFgOver;
}
sereinSettingsButtonPlainDescribed: SettingsButton(settingsButtonNoIcon) {
	padding: margins(22px, 10px, 22px, 3px);
}
sereinSettingsAbout: FlatLabel(settingsExperimentalAbout) {
}
sereinSettingsAboutPadding: margins(60px, 0px, 22px, 11px);
sereinSettingsAboutPlainPadding: margins(22px, 0px, 22px, 10px);

sereinInspectorWidth: 480px;
sereinInspectorTextPadding: margins(22px, 4px, 22px, 8px);
sereinInspectorRaw: FlatLabel(defaultFlatLabel) {
	minWidth: 100px;
}
sereinPurgeOptionPadding: margins(22px, 8px, 22px, 4px);

sereinSnapshotWidth: 640px;
sereinSnapshotPadding: 16px;
sereinSnapshotHeaderHeight: 40px;
sereinSnapshotAvatarSize: 32px;
sereinSnapshotPreviewHeight: 200px;
sereinSnapshotPreviewMinimum: 80px;

sereinSenderOnlineSize: 11px;
sereinSenderOnlineStroke: 2px;
sereinHistoryMarkPalette: TextPalette(defaultTextPalette) {
	linkFg: attentionButtonFg;
	selectLinkFg: attentionButtonFg;
}
sereinHistoryDeletedMark: IconEmoji {
	icon: icon{{ "menu/delete-12x12", attentionButtonFg }};
	padding: margins(0px, 3px, 2px, 0px);
}
sereinHistoryEditedMark: IconEmoji {
	icon: icon{{ "menu/edit-12x12", attentionButtonFg }};
	padding: margins(0px, 3px, 2px, 0px);
}

sereinStoryPreviewSize: size(135px, 240px);
sereinMediaMenuIconEdit: icon {{ "menu/edit", mediaviewMenuFg }};
sereinStoryCaption: InputField(defaultInputField) {
	heightMax: 148px;
}

sereinFormatToolbar: InnerDropdown(defaultInnerDropdown) {
	scrollMargin: margins(4px, 4px, 4px, 4px);
}
sereinFormatToolbarButton: IconButton(defaultIconButton) {
	width: 36px;
	height: 36px;
	iconPosition: point(-1px, -1px);
	rippleAreaPosition: point(0px, 0px);
	rippleAreaSize: 36px;
	ripple: defaultRippleAnimationBgOver;
}
sereinFormatToolbarSkip: 4px;
sereinFormatBold: icon {{ "menu/rich/bold-24x24", menuIconColor }};
sereinFormatBoldActive: icon {{ "menu/rich/bold-24x24", windowActiveTextFg }};
sereinFormatItalic: icon {{ "menu/rich/italic-24x24", menuIconColor }};
sereinFormatItalicActive: icon {{ "menu/rich/italic-24x24", windowActiveTextFg }};
sereinFormatUnderline: icon {{ "menu/rich/underline-24x24", menuIconColor }};
sereinFormatUnderlineActive: icon {{ "menu/rich/underline-24x24", windowActiveTextFg }};
sereinFormatStrikeOut: icon {{ "menu/rich/strikeout-24x24", menuIconColor }};
sereinFormatStrikeOutActive: icon {{ "menu/rich/strikeout-24x24", windowActiveTextFg }};
sereinFormatCode: icon {{ "menu/rich/code-24x24", menuIconColor }};
sereinFormatCodeActive: icon {{ "menu/rich/code-24x24", windowActiveTextFg }};
sereinFormatSpoiler: icon {{ "menu/rich/spoiler-24x24", menuIconColor }};
sereinFormatSpoilerActive: icon {{ "menu/rich/spoiler-24x24", windowActiveTextFg }};
sereinFormatQuote: icon {{ "menu/rich/blockquote-24x24", menuIconColor }};
sereinFormatQuoteActive: icon {{ "menu/rich/blockquote-24x24", windowActiveTextFg }};
sereinFormatLink: icon {{ "menu/rich/link-24x24", menuIconColor }};
sereinFormatLinkActive: icon {{ "menu/rich/link-24x24", windowActiveTextFg }};
sereinFormatClear: icon {{ "menu/clear", menuIconColor }};

compactDialogRow: DialogRow(defaultDialogRow) {
	height: 54px;
	padding: margins(10px, 6px, 10px, 6px);
	photoSize: 40px;
	nameLeft: 62px;
	nameTop: 6px;
	textLeft: 62px;
	textTop: 28px;
}
twoLineDialogRow: DialogRow(defaultDialogRow) {
	height: 82px;
}
threeLineDialogRow: DialogRow(defaultDialogRow) {
	height: 102px;
}
compactTwoLineDialogRow: DialogRow(compactDialogRow) {
	height: 74px;
}
compactThreeLineDialogRow: DialogRow(compactDialogRow) {
	height: 94px;
}

menuIconRepeat: icon {{ "menu/repeat", menuIconColor }};
menuIconSerein: icon {{ "menu/serein", menuIconColor }};

sereinHomeCoverPadding: margins(16px, 20px, 16px, 16px);
sereinHomeCoverLogo: 72px;
sereinHomeCoverLogoSkip: 12px;
sereinHomeCoverLineSkip: 4px;
sereinAboutIntro: FlatLabel(defaultFlatLabel) {
	align: align(top);
	minWidth: 40px;
}

sereinFolderDesk: icon {{ "serein/folders/desk-28x28", sideBarIconFg }};
sereinFolderDeskActive: icon {{ "serein/folders/desk-28x28", sideBarIconFgActive }};
sereinFolderDeskTabs: icon {{ "serein/folders/desk-18x18", windowSubTextFg }};
sereinFolderDeskUserpic: icon {{ "serein/folders/desk-28x28", windowFgActive }};
