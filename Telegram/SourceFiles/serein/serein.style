sereinFolderCalendarActive: icon {{ "serein/folders/calendar-28x28", sideBarIconFgActive }};
sereinFolderCalendarTabs: icon {{ "serein/folders/calendar-18x18", windowSubTextFg }};
sereinFolderCalendarUserpic: icon {{ "serein/folders/calendar-28x28", windowFgActive }};
