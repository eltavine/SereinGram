sereinFolderDocumentActive: icon {{ "serein/folders/document-28x28", sideBarIconFgActive }};
sereinFolderDocumentTabs: icon {{ "serein/folders/document-18x18", windowSubTextFg }};
sereinFolderDocumentUserpic: icon {{ "serein/folders/document-28x28", windowFgActive }};
sereinFolderTools: icon {{ "serein/folders/tools-28x28", sideBarIconFg }};
sereinFolderToolsActive: icon {{ "serein/folders/tools-28x28", sideBarIconFgActive }};
sereinFolderToolsTabs: icon {{ "serein/folders/tools-18x18", windowSubTextFg }};
sereinFolderToolsUserpic: icon {{ "serein/folders/tools-28x28", windowFgActive }};
sereinFolderWrench: icon {{ "serein/folders/wrench-28x28", sideBarIconFg }};
sereinFolderWrenchActive: icon {{ "serein/folders/wrench-28x28", sideBarIconFgActive }};
sereinFolderWrenchTabs: icon {{ "serein/folders/wrench-18x18", windowSubTextFg }};
sereinFolderWrenchUserpic: icon {{ "serein/folders/wrench-28x28", windowFgActive }};
sereinFolderCamera: icon {{ "serein/folders/camera-28x28", sideBarIconFg }};
sereinFolderCameraActive: icon {{ "serein/folders/camera-28x28", sideBarIconFgActive }};
sereinFolderCameraTabs: icon {{ "serein/folders/camera-18x18", windowSubTextFg }};
sereinFolderCameraUserpic: icon {{ "serein/folders/camera-28x28", windowFgActive }};
sereinFolderHeadphones: icon {{ "serein/folders/headphones-28x28", sideBarIconFg }};
sereinFolderHeadphonesActive: icon {{ "serein/folders/headphones-28x28", sideBarIconFgActive }};
sereinFolderHeadphonesTabs: icon {{ "serein/folders/headphones-18x18", windowSubTextFg }};
sereinFolderHeadphonesUserpic: icon {{ "serein/folders/headphones-28x28", windowFgActive }};
sereinFolderPaw: icon {{ "serein/folders/paw-28x28", sideBarIconFg }};
sereinFolderPawActive: icon {{ "serein/folders/paw-28x28", sideBarIconFgActive }};
sereinFolderPawTabs: icon {{ "serein/folders/paw-18x18", windowSubTextFg }};
sereinFolderPawUserpic: icon {{ "serein/folders/paw-28x28", windowFgActive }};
sereinFolderCoffee: icon {{ "serein/folders/coffee-28x28", sideBarIconFg }};
sereinFolderCoffeeActive: icon {{ "serein/folders/coffee-28x28", sideBarIconFgActive }};
sereinFolderCoffeeTabs: icon {{ "serein/folders/coffee-18x18", windowSubTextFg }};
sereinFolderCoffeeUserpic: icon {{ "serein/folders/coffee-28x28", windowFgActive }};
sereinFolderBooks: icon {{ "serein/folders/books-28x28", sideBarIconFg }};
