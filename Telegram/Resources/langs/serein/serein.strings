"lng_serein_seconds_in_messages_about" = "Message times also show seconds, as do edit times, original forward times and read times.";
"lng_serein_show_forwarded_message_date_about" = "Forwarded messages show the date and time the original was sent instead of when it was forwarded.";
"lng_serein_show_service_time_about" = "Service messages, such as someone joining or a message being pinned, show their time after the text.";
"lng_serein_show_message_id_about" = "Hovering the time of a message also shows its ID, the number at the end of the message link.";
"lng_serein_persian_calendar_about" = "Shows dates in the Solar Hijri calendar used in Iran instead of the Gregorian calendar.";
"lng_serein_exact_message_counters_about" = "View and reply counts next to the message time show the full number, such as 12,345, instead of 12.3K.";
"lng_serein_hide_message_views_about" = "Removes the eye icon and view count next to the time of channel posts. Only the display on this device changes.";
"lng_serein_hide_channel_signature_about" = "Removes the author name that channels with signatures show next to the time of each post.";
"lng_serein_hide_edited_badge_about" = "Edited messages no longer show the “edited” label next to their time; the label text option is hidden while this is on.";
"lng_serein_edited_mark_about" = "Replaces the word “edited” next to the time of edited messages. Leave empty to use the default text.";
"lng_serein_deleted_mark_about" = "Replaces the word “deleted” next to the time of deleted messages that are kept. Leave empty to use the default text.";
"lng_serein_fade_deleted_messages_about" = "Deleted messages kept in the chat are drawn at 60% opacity. Needs “Keep deleted messages in chat”.";
"lng_serein_highlight_history_marks_about" = "Deleted and edited labels turn red with a trash or pencil icon. For edited ones this needs “Keep edit history” on.";
"lng_serein_show_channel_badge_about" = "In groups, messages sent on behalf of a channel show a “channel” badge next to the sender's name, like admin titles do.";
"lng_serein_hide_reactions_about" = "Hides reactions under messages and the reaction button shown on hover, in every chat. Turn it off to pick chat types below.";
"lng_serein_hide_private_reactions_about" = "Hides reactions and the reaction button shown on hover in one-on-one chats only.";
"lng_serein_hide_group_reactions_about" = "Hides reactions and the reaction button shown on hover in groups only.";
"lng_serein_hide_channel_reactions_about" = "Hides reactions and the reaction button shown on hover in channels only.";
"lng_serein_hide_reaction_menu_about" = "Right-clicking a message no longer shows the reaction strip above the menu. Reactions under messages stay visible.";
"lng_serein_hide_reaction_menu_when_selecting_about" = "While messages are selected, the right-click menu opens without the reaction strip. Otherwise the menu is unchanged.";
"lng_serein_disable_premium_sticker_effects_about" = "Premium stickers no longer play their large animation around the sticker. The sticker itself still animates.";
"lng_serein_disable_emoji_interactions_about" = "Clicking a single large emoji no longer plays its animation over the chat, including ones the other person triggers.";
"lng_serein_disable_message_effects_about" = "Animated effects that senders attach to messages, such as confetti, are no longer played.";
"lng_serein_reveal_spoilers_about" = "Text and media marked as spoilers are shown uncovered right away, without clicking them first.";
"lng_serein_hide_quick_share_about" = "Removes the round forward button beside channel posts and some bot messages. Forwarding from the message menu still works.";
"lng_serein_hide_recommended_channels_about" = "Removes the list of similar channels that Telegram suggests in a channel after you join it.";
"lng_serein_hide_premium_badges_about" = "Removes the Premium star and emoji statuses shown next to names, such as in the chat list and profiles. Verified checks stay.";
"lng_serein_hide_saved_tags_about" = "Hides the tag bar when searching Saved Messages and the tag picker in its message menu. Selected tags stay visible.";
"lng_serein_hide_private_chat_activities_about" = "Typing, recording and other statuses of the other person no longer show in the chat header or chat list.";
"lng_serein_reading_spacing_about" = "Shows spaces between Chinese characters and Latin letters or digits in messages; the message menu can show the original.";
"lng_serein_raise_selection_limit_about" = "Raises the limit on selected messages from 100 to 1000 for forwarding and deleting. Applies after a restart.";
"lng_serein_double_click_edits_own_about" = "Double-clicking your own message opens it for editing, as long as Telegram still allows editing it.";
"lng_serein_revoke_private_chat_deletion_about" = "Deleting or clearing a one-on-one chat also removes it for the other person unless you uncheck the box.";
"lng_serein_moderate_report_spam_about" = "Deleting a member's messages as an admin also reports them as spam unless you uncheck the box.";
"lng_serein_moderate_delete_all_about" = "Deleting a member's messages as an admin also deletes everything else they sent in the group unless you uncheck the box.";
"lng_serein_moderate_ban_about" = "Deleting a member's messages as an admin also bans them from the group unless you uncheck the box.";
"lng_serein_confirm_repeat_about" = "Asks before “Repeat” and “Repeat without attribution” forward the message into the same chat again.";
"lng_serein_quick_rating_first_about" = "Adds a message menu item that instantly replies with this text. Leave empty to hide the item.";
"lng_serein_quick_rating_second_about" = "Adds a second message menu item that instantly replies with this text. Leave empty to hide the item.";
"lng_serein_hide_attach_button_about" = "Removes the paperclip button from the message field. You can still paste files or drag them into the chat.";
"lng_serein_hide_emoji_button_about" = "Removes the button that opens the emoji, sticker and GIF panel from the message field.";
"lng_serein_hide_recording_button_about" = "Removes the voice and video message button next to the message field; the send button is shown in its place.";
"lng_serein_hide_bot_command_button_about" = "Hides the / button that lists bot commands in groups with bots. Typing / in the message field still shows them.";
"lng_serein_hide_bot_menu_about" = "Hides the Menu button in bot chats that opens the bot's commands or mini app. Typing / still lists the commands.";
"lng_serein_hide_auto_delete_button_about" = "Hides the timer button shown in chats with auto-delete turned on. Messages still disappear on the chat's timer.";
"lng_serein_hide_gift_button_about" = "Hides the gift button that appears in some private chats, such as on a birthday. You can still send gifts from the profile.";
"lng_serein_hide_ai_button_about" = "Hides the AI tools button that appears in the message field once your text reaches three lines. Media caption fields keep it.";
"lng_serein_hide_send_as_button_about" = "Hides the avatar button for choosing who you post as in groups and channels. Messages keep the identity you chose last.";
"lng_serein_hide_stars_reaction_button_about" = "Hides the Stars button in the reply bar of Live Stories, which sends paid Star reactions to the stream.";
"lng_serein_hide_channel_mute_button_about" = "Removes the Mute or Unmute bar at the bottom of channels you can't post in. You can still mute them from the chat menu.";
"lng_serein_disable_emoji_hover_about" = "The emoji, sticker and GIF panel opens only when you click its button, not when the pointer rests on it.";
"lng_serein_disable_attach_hover_about" = "The attachment menu opens only when you click the paperclip button, not when the pointer rests on it.";
"lng_serein_bot_commands_to_draft_about" = "Clicking a /command in a message or the suggestion list puts it in the field instead of sending it. Bot keyboard buttons still send.";
"lng_serein_mention_menu_about" = "Right-clicking selected text in the message field lets you turn it into a mention of a user, found by username, link or ID.";
"lng_serein_input_placeholder_mode_about" = "Sets the hint in an empty message field: Telegram's default, the chat name, or your Send As identity. Channels and topics keep theirs.";
"lng_serein_disable_auto_markdown_about" = "Typed **bold**, __italic__ or `code` markers stay as plain text instead of becoming formatting. Formatting from the menu still works.";
"lng_serein_format_toolbar_about" = "Selecting text in a message field shows a floating bar with bold, italic, spoiler, quote, link and other formatting buttons.";
"lng_serein_space_on_send_about" = "Adds a space between Chinese characters and Latin letters or digits in messages and captions you send. Code, links and mentions stay as is.";
"lng_serein_space_on_edit_about" = "Applies the same Chinese–Latin spacing when you save an edited message. Code, links and mentions stay as is.";
"lng_serein_draft_translation_about" = "Translates the draft with your manual translation service and can replace it with the result. The draft text is sent to that service.";
"lng_serein_disable_link_preview_about" = "Messages with links are sent without a preview card, as if you had closed the preview each time.";
"lng_serein_caption_above_media_about" = "The window for sending photos and videos starts with the caption above the media. You can switch it back in the Send button's menu.";
"lng_serein_send_silently_about" = "Everything you send from this device goes out as “Send without sound”, so recipients get a notification with no sound.";
"lng_serein_owner_send_as_about" = "Lets you post as the group or as yourself in supergroups you created, right from the Send As button.";
"lng_serein_confirm_sticker_about" = "Asks before sending a sticker you picked, so a stray click doesn't send it.";
