<?xml version="1.0" encoding="utf-8"?>
<component type="desktop">
    <id>io.github.eltavine.SereinGram</id>
    <metadata_license>CC0-1.0</metadata_license>
    <project_license>GPL-3.0</project_license>
    <name>SereinGram</name>
    <summary>Feature-rich Telegram client</summary>
    <description>
        <p>SereinGram is an independent Telegram client based on Telegram Desktop. It keeps every Telegram feature and adds optional ones, such as ghost mode, a local history of edited and deleted messages, message filters, external translation services and many chat list, message and interface adjustments.</p>
        <p>Every added feature stays off until you enable it, so a new installation behaves like Telegram Desktop.</p>
    </description>
    <categories>
        <category>Network</category>
        <category>InstantMessaging</category>
    </categories>
    <developer id="io.github.eltavine"><name>SereinGram contributors</name></developer>
    <url type="homepage">https://github.com/eltavine/SereinGram/</url>
    <url type="faq">https://telegram.org/faq</url>
    <url type="bugtracker">https://github.com/eltavine/SereinGram/issues</url>
    <url type="translate">https://translations.telegram.org/</url>
    <url type="vcs-browser">https://github.com/eltavine/SereinGram</url>
    <url type="contribute">https://github.com/eltavine/SereinGram/blob/main/.github/CONTRIBUTING.md</url>
    <branding>
        <color type="primary" scheme_preference="light">#edf0f2</color>
        <color type="primary" scheme_preference="dark">#2d363f</color>
    </branding>
    <keywords>
        <keyword>tg</keyword>
        <keyword>telegram</keyword>
        <keyword>tdesktop</keyword>
        <keyword>messaging</keyword>
        <keyword>messenger</keyword>
        <keyword>chat</keyword>
        <keyword>sms</keyword>
        <keyword>im</keyword>
    </keywords>
    <requires>
        <!-- windowMinHeight from Telegram/SourceFiles/window/window.style -->
        <display_length compare="ge">480</display_length>
        <internet>always</internet>
        <!-- on-screen keyboards are too big for current minimal display height -->
        <control>keyboard</control>
    </requires>
    <supports>
        <control>pointing</control>
        <control>touch</control>
    </supports>
